        "### (Unused) Evaluation: latency-qps w/ and w/o retrieval\n",
        "\n",
        "Here, we compare the performance with/without retrieval on models with different sizes. We assume the best retrieval parallelism is used here."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "collapsed": true,
        "id": "GqSKqe-Qaren"
      },
      "outputs": [],
      "source": [
        "# Key = (size, retrieval_or_not), e.g., ('8b', True)\n",
        "result_df_dict_case_1_whether_retrieval = {}\n",
        "\n",
        "model_sizes = ['8b', '70b']\n",
        "retrieval_options = ['with retrieval',\n",
        "                     'no retrieval (with augmented prompt)',\n",
        "                     'no retrieval (only question)']\n",
        "\n",
        "for model_size in model_sizes:\n",
        "  result_df_dict_case_1_whether_retrieval[model_size] = {}\n",
        "  for retrieval_option in retrieval_options:\n",
        "\n",
        "    if retrieval_option == 'with retrieval':\n",
        "      use_retrieval = True\n",
        "      seq_len_inference_prefix = 512\n",
        "    elif retrieval_option == 'no retrieval (with augmented prompt)':\n",
        "      use_retrieval = False\n",
        "      seq_len_inference_prefix = 512\n",
        "    elif retrieval_option == 'no retrieval (only question)':\n",
        "      use_retrieval = False\n",
        "      seq_len_inference_prefix = 32\n",
        "    else:\n",
        "      raise ValueError(f'Unknown retrieval option: {retrieval_option}')\n",
        "\n",

      "outputs": [],
      "source": [
        "def clean_sweep_df(\n",
        "    df: pd.DataFrame,\n",
        "    is_retrieval=False,\n",
        "    return_pareto=True,\n",
        "    use_latency_after_throttling: bool = False,\n",
        "    qps_cutoff: float = 1.0, # remove points within 5% of optimal QPS\n",
        "    num_chips_keep_power_of_two = False,\n",
        ") -> pd.DataFrame:\n",
        "  \"\"\"This function does several things:\n",
        "\n",
        "  1. Drop unused columns\n",
        "  2. Remove some of the column prefixes (model_params, sharding, system, results)\n",
        "  3. Filter out unqualified rows (memory overflow)\n",
        "  4. Convert rag_param.scam_params from a string dict to columns in the df\n",
        "  5. Compute basic stats like latency and QPS-per-chip (retrieval assumes 4 chips)\n",
        "  6. Potentially only keep the Pareto points\n",
        "\n",
        "  Args:\n",
        "    df: A pandas DataFrame output from ART.\n",
        "    is_decode: whether it's the decode case --- for which we need to set the e2e latency\n",
        "      as dec_steps x latency per step.\n",
        "    use_latency_after_throttling: Bool to choose between reading 'roofline' or\n",
        "      'roofline_after_throttling.\n",
        "\n",
        "  Returns:\n",
        "    An updated DataFrame.\n",
        "  \"\"\"\n",
        "\n",
        "  # Drop unused columns\n",
        "  columns_to_drop =set(df.columns.to_list()) - set(COLS_TO_KEEP)\n",
        "  df = df.drop(columns_to_drop, axis=1)\n",
        "\n",
        "  # Type cast all values which can be cast to float.\n",
        "  for c in df.columns:\n",
        "    if 'results.' in c:\n",
        "      try:\n",
        "        df[c] = df[c].astype(float)\n",
        "      except Exception:  # pylint: disable=broad-exception-caught\n",
        "        pass\n",
        "\n",
        "  # cleanup column names\n",
        "  def rename_columns(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    df.columns = df.columns.str.removeprefix('model_params.')\n",
        "    df.columns = df.columns.str.removeprefix('sharding.')\n",
        "    df.columns = df.columns.str.removeprefix('system.')\n",
        "    df.columns = df.columns.str.removeprefix('results.')\n",
        "    df = df.rename(columns={'name': 'system_name'})\n",
        "\n",
        "    # Expand scam parameters, which is stored as a string representation of disk\n",
        "    # For each row in the df, load the dict use ast.literal_eval\n",
        "    if is_retrieval:\n",
        "      scam_columns = {}\n",
        "      for index, row in df.iterrows():\n",
        "        parsed_scam_params = ast.literal_eval(row['rag_param.scam_params'])\n",
        "        row['rag_param.scam_params'] = parsed_scam_params\n",
        "        scam_params_keys = row['rag_param.scam_params'].keys()\n",
        "        if index == 0:\n",
        "          for key in scam_params_keys:\n",
        "            scam_columns[key] = [parsed_scam_params[key]]\n",
        "        else:\n",
        "          for key in scam_params_keys:\n",
        "            scam_columns[key].append(parsed_scam_params[key])\n",
        "      scam_columns = pd.DataFrame(scam_columns)\n",
        "      df = pd.concat([df, scam_columns], axis=1)\n",
        "    return df\n",
        "\n",
        "  df = rename_columns(df)\n",
        "\n",
        "  def filter_results_by_hbm_capacity(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    \"\"\"Remove rows with peak HBM footprint that exceeds capacity.\n",
        "\n",
        "    Also Get the maximum possible batch size that does not exceed capacity.\"\"\"\n",
        "\n",
        "    df['peak_memory_hbm'] = (\n",
        "      # df['peak_memory_activations_hbm'] +\n",
        "      df['peak_memory_weights_hbm'] +\n",
        "      # df['peak_memory_gradients_hbm'] +\n",
        "      df['peak_memory_kv_cache_hbm']\n",
        "    )\n",
        "    df['cap_hbm_usage'] = (\n",
        "            (df['memory.hbm.capacity']\n",
        "            - df['memory.hbm.reserve_capacity']) / (1024 ** 2)\n",
        "        )\n",
        "    df = df.loc[(df['peak_memory_hbm'] <= df['cap_hbm_usage'])]\n",
        "\n",
        "    # get the maximum possible batch size based on memory capacity\n",
        "    batch_memory_consumption = (\n",
        "      df['peak_memory_activations_hbm'] +\n",
        "      df['peak_memory_gradients_hbm'] +\n",
        "      df['peak_memory_kv_cache_hbm'])\n",
        "    # for inference\n",
        "    if np.all(batch_memory_consumption.tolist()):\n",
        "      memory_capacity_left_for_batching = df['cap_hbm_usage'] - df['peak_memory_weights_hbm']\n",
        "      df['max_possible_batch_size'] = (\n",
        "          df['batch_size'] *\n",
        "          memory_capacity_left_for_batching / batch_memory_consumption)\n",
        "    # for retrieval\n",
        "    else:\n",
        "      df['max_possible_batch_size'] = float('inf')\n",
        "\n",
        "    return df\n",
        "\n",
        "  # Filter out rows for invalid configs based on memory capacity.\n",
        "  df = filter_results_by_hbm_capacity(df)\n",
        "\n",
        "  def get_num_chips(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    \"\"\"Get the number of chips in the sweep.\"\"\"\n",
        "    def get_ways(mapping):\n",
        "      if pd.isna(mapping):\n",
        "        return 1\n",
        "      mapping_list = list(map(int,mapping.lstrip('[').rstrip(']').split(','),))\n",
        "      return math.prod(mapping_list)\n",
        "\n",
        "    # Compute m, x, w parallelism ways.\n",
        "    for col_prefix in ['m', 'x', 'w']:\n",
        "      col_mapping = col_prefix + '_mapping'\n",
        "      col_ways = col_prefix + '_ways'\n",
        "\n",
        "      if col_mapping in df.columns:\n",
        "        df[col_ways] = df[col_mapping].apply(get_ways)\n",
        "\n",
        "    df['num_chips'] = (df['m_ways'] * df['num_stages']).astype(int)\n",
        "    if 'x_mapping' in df.columns:\n",
        "      df['num_chips'] *= df['x_ways'].astype(int)\n",
        "    if 'w_mapping' in df.columns:\n",
        "      df['num_chips'] *= df['w_ways'].astype(int)\n",
        "\n",
        "    # Scale the number of chiplets by the number of chiplets in a package if the\n",
        "    # sweep was run in non-MegaCore mode.\n",
        "    if (\n",
        "        'chiplet_settings.non_megacore_mode' in df.columns\n",
        "        and 'chiplet_settings.chiplet_scale_factor' in df.columns\n",
        "        and df.iloc[0]['chiplet_settings.non_megacore_mode']\n",
        "    ):\n",
        "      df['num_chips'] //= df['chiplet_settings.chiplet_scale_factor']\n",
        "\n",
        "    return df\n",
        "\n",
        "  # Get number of chips\n",
        "  df = get_num_chips(df)\n",
        "  if is_retrieval:\n",
        "    df['num_chips'] = 4\n",
        "\n",
        "  if num_chips_keep_power_of_two:\n",
        "    num_chips_list_all = sorted(set(df['num_chips'].to_list()))\n",
        "    num_chips_list = []\n",
        "    for num_chips in num_chips_list_all:\n",
        "      if is_power_of_two(num_chips):\n",
        "        num_chips_list.append(num_chips)\n",
        "    df = df.loc[df['num_chips'].isin(num_chips_list)]\n",
        "\n",
        "  def get_performance(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    \"\"\"Get the QPS and latency of the sweep.\"\"\"\n",
        "    roofline_time_ms = (\n",
        "        df['roofline_after_throttling']\n",
        "        if use_latency_after_throttling\n",
        "        else df['roofline']\n",
        "    )\n",
        "    df['latency_s'] = (roofline_time_ms / 1000.0).astype(float)\n",
        "    for index, row in df.iterrows():\n",
        "      if row['model_phase'] == \"inference_decode\":\n",
        "          df.at[index, 'latency_s'] = row['latency_s'] * row['dec_steps']\n",
        "\n",
        "    df['qps'] = (df['batch_size'] / df['latency_s']).astype(float)\n",
        "    df['qps_per_chip'] = (df['qps'] / df['num_chips']).astype(float)\n",
        "\n",
        "    return df\n",
        "\n",
        "  # get QPS and latency\n",
        "  df = get_performance(df)\n",
        "\n",
        "  # Potentially only return Pareto: given the same number of chips,\n",
        "  # leave the best performance --- Note that different number of chips may\n",
        "  # have overlaps in Pareto, which is needed for the cost assembler later on\n",
        "  def return_pareto_per_chip_number(\n",
        "      df: pd.DataFrame,\n",
        "      unique_groups_retrieval: list[str] = ['db_nvec', 'parallel_mode_pq_scan_leaf'],\n",
        "      unique_groups_inference: list[str] = ['seq_len_inference_prefix', 'dec_steps']\n",
        "      ) -> pd.DataFrame:\n",
        "    \"\"\"Return Pareto of each chip number, given each unique group.\n",
        "\n",
        "    Here, unique groups means differnet category of performance that should\n",
        "    not be evaluated in the same Pareto. E.g., parallel model for retrieval,\n",
        "    prefix and decode steps in LLM inference.\n",
        "    \"\"\"\n",
        "    unique_group_cols = unique_groups_retrieval if is_retrieval else unique_groups_inference\n",
        "    for col_name in unique_group_cols:\n",
        "      if col_name not in df.columns:\n",
        "        unique_group_cols.remove(col_name)\n",
        "    unique_groups = set(df[unique_group_cols].itertuples(index=False, name=None))\n",
        "\n",
        "    df_pareto_dict = {}\n",
        "\n",
        "    for group in unique_groups:\n",
        "      # Get the selected group subset\n",
        "      print(\"group: \", group)\n",
        "      selected_df = copy.deepcopy(df)\n",
        "      df_pareto_per_group_dict = {}\n",
        "      for i, col_name in enumerate(unique_group_cols):\n",
        "        selected_df = get_filtered_df(selected_df, {col_name: group[i]})\n",
        "      # print(\"selected_df: \", get_filtered_df(selected_df, {'num_chips': 1})[['batch_size', 'latency_s', 'qps_per_chip', 'qps']])\n",
        "      # Iterate over chip number, get the Pareto per chip number\n",
        "      num_chips_list = sorted(set(df['num_chips'].to_list()))\n",
        "      for num_chips in num_chips_list:\n",
        "        assert is_power_of_two(num_chips)\n",
        "        df_subset = get_filtered_df(selected_df, {'num_chips': num_chips})\n",
        "        df_pareto = get_pareto_df(\n",
        "            sweep_df=df_subset,\n",
        "            keys_lower_is_better=[\n",
        "              ('latency_s', True),\n",
        "              ('qps_per_chip', False),\n",
        "              ('qps', False),\n",
        "              ],\n",
        "            qps_cutoff=qps_cutoff,\n",
        "        )\n",
        "        # print(\"num_chips: \", num_chips)\n",
        "        # print(\"df_pareto: \", df_pareto[['batch_size', 'latency_s', 'qps_per_chip', 'qps']])\n",
        "        # it can also be composed by two subsystems with half size\n",
        "        num_chips_half = int(num_chips / 2)\n",
        "        if num_chips_half in num_chips_list:\n",
        "          df_pareto_alter = copy.deepcopy(df_pareto_per_group_dict[num_chips_half])\n",
        "          # twice batch size, same latency\n",
        "          df_pareto_alter['batch_size'] = df_pareto_alter['batch_size'] * 2\n",
        "          df_pareto_alter['qps'] = df_pareto_alter['qps'] * 2\n",
        "          df_pareto = pd.concat([df_pareto, df_pareto_alter], axis=0)\n",
        "          df_pareto = get_pareto_df(\n",
        "              sweep_df=df_pareto,\n",
        "              keys_lower_is_better=[\n",
        "                ('latency_s', True),\n",
        "                ('qps_per_chip', False),\n",
        "                ('qps', False),\n",
        "                ],\n",
        "              qps_cutoff=qps_cutoff,\n",
        "          )\n",
        "          # overwrite the setups from replicating half chips\n",
        "          df_pareto['num_chips'] = num_chips\n",
        "\n",
        "        df_pareto_per_group_dict[num_chips] = df_pareto\n",
        "\n",
        "      df_pareto_dict[group] = pd.concat(df_pareto_per_group_dict.values())\n",
        "\n",
        "    df = pd.concat(df_pareto_dict.values())\n",
        "\n",
        "    return df\n",
        "\n",
        "  if return_pareto:\n",
        "    df = return_pareto_per_chip_number(df)\n",
        "\n",
        "  return df\n",
        "\n",
        "def print_basic_sweep_info(df_sweep: pd.DataFrame):\n",
        "  \"\"\"Print basic sweep info for manual sanity checking.\"\"\"\n",
        "  idx = df_sweep['num_chips'].idxmax()\n",
        "\n",
        "  # print('df all index: ', df_sweep.allindex)\n",
        "  row = df_sweep.loc[idx]\n",
        "  print(\"\\n=== Max num_chips: \", row['num_chips'])\n",
        "  print('m_ways', row['m_ways'])\n",
        "  print('num_stages',row['num_stages'])\n",
        "\n",
        "  idx = df_sweep['num_chips'].idxmin()\n",
        "  row = df_sweep.loc[idx]\n",
        "  print(\"\\n=== Min num_chips: \", row['num_chips'])\n",
        "  print('m_ways', row['m_ways'])\n",
        "  print('num_stages',row['num_stages'])\n",
        "\n",
        "  idx = df_sweep['peak_memory_hbm'].idxmax()\n",
        "  row = df_sweep.loc[idx]\n",
        "  print('\\n=== Max peak_memory_hbm (MB):', row['peak_memory_hbm'])\n",
        "  print('seq_len_inference_prefix',row['seq_len_inference_prefix'])\n",
        "  print('batch_size', row['batch_size'])\n",
        "  print('num_chips', row['num_chips'])\n",
        "\n",
        "  idx = df_sweep['peak_memory_hbm'].idxmin()\n",
        "  row = df_sweep.loc[idx]\n",
        "  print('\\n=== Min peak_memory_hbm (MB):', row['peak_memory_hbm'])\n",
        "  print('seq_len_inference_prefix',row['seq_len_inference_prefix'])\n",
        "  print('batch_size', row['batch_size'])\n",
        "  print('num_chips', row['num_chips'])\n",
        "\n",
        "def plot_pareto_info(\n",
        "    df_pareto: pd.DataFrame,\n",
        "    is_retrieval: bool = False,\n",
        "    constraints: dict[str, Any] = None,\n",
        "    plot_pareto: bool = True,\n",
        "    y_log=False,\n",
        "  ):\n",
        "\n",
        "  df = get_filtered_df(df_pareto, constraints)\n",
        "  if is_retrieval:\n",
        "    unique_group_cols = ['db_nvec', 'parallel_mode_pq_scan_leaf']\n",
        "  else:\n",
        "    unique_group_cols = ['seq_len_inference_prefix', 'dec_steps']\n",
        "\n",
        "  for col_name in unique_group_cols:\n",
        "    if col_name not in df.columns:\n",
        "      unique_group_cols.remove(col_name)\n",
        "  unique_groups = set(df[unique_group_cols].itertuples(index=False, name=None))\n",
        "  legend_list = []\n",
        "  df_list = []\n",
        "  for group in unique_groups:\n",
        "    label = ''\n",
        "    selected_df = copy.deepcopy(df)\n",
        "    for i, col_name in enumerate(unique_group_cols):\n",
        "      label += ', ' if i > 0 else ''\n",
        "      label += '{}: {}'.format(col_name, group[i])\n",
        "      selected_df = get_filtered_df(selected_df, {col_name: group[i]})\n",
        "\n",
        "    # get pareto across number of chips\n",
        "    if plot_pareto:\n",
        "      selected_df = get_pareto_df(\n",
        "          selected_df,\n",
        "          keys_lower_is_better=[('latency_s', True), ('qps_per_chip', False)])\n",
        "    legend_list.append(label)\n",
        "    df_list.append(selected_df)\n",
        "\n",
        "  if is_retrieval:\n",
        "    plot_curve_df(\n",
        "      df_list=df_list,\n",
        "      legend_list=legend_list,\n",
        "      x_key='latency_s',\n",
        "      y_key='qps_per_chip',\n",
        "      x_label='Latency (s)',\n",
        "      y_label='QPS per chip',\n",
        "      x_log=False,\n",
        "      y_log=y_log,\n",
        "      x_lim=None,\n",
        "      y_lim=None,\n",
        "      y_lim_low=None,\n",
        "      x_lim_low=None,\n",
        "      markersize=5,\n",
        "      label_font = 12,\n",
        "      title_font = 12,\n",
        "      legend_font = 10,\n",
        "      tick_font = 10,\n",
        "      legend_ncol = 1,\n",
        "      legend_loc=(0.0, 1.02),\n",
        "      figsize=(6,4),\n",
        "      plot_style='seaborn-v0_8-pastel'\n",
        "    )\n",
        "  else:\n",
        "    plot_curve_df(\n",
        "      df_list=df_list,\n",
        "      legend_list=legend_list,\n",
        "      x_key='latency_s',\n",
        "      y_key='qps_per_chip',\n",
        "      x_label='Latency (s)',\n",
        "      y_label='QPS per chip',\n",
        "      x_log=True,\n",
        "      y_log=y_log,\n",
        "      x_lim=None,\n",
        "      y_lim=None,\n",
        "      y_lim_low=None,\n",
        "      x_lim_low=None,\n",
        "      markersize=5,\n",
        "      label_font = 12,\n",
        "      title_font = 12,\n",
        "      legend_font = 10,\n",
        "      tick_font = 10,\n",
        "      legend_ncol = 1,\n",
        "      legend_loc=(0.0, 1.02),\n",
        "      figsize=(6,4),\n",
        "      plot_style='seaborn-v0_8-pastel'\n",
        "    )\n",
        "\n",
        "def load_sweep_info(\n",
        "    sweep_path: str,\n",
        "    is_retrieval=False,\n",
        "    return_pareto=True,\n",
        "    print_memory=True,\n",
        "    clear_colossus_cahce=False,\n",
        "    use_latency_after_throttling: bool = False,\n",
        "    qps_cutoff: float = 1.0, # remove points within 5% of optimal QPS,\n",
        "    num_chips_keep_power_of_two=False,\n",
        "    ):\n",
        "  \"\"\" Load sweep and return cleaned dataframe \"\"\"\n",
        "\n",
        "  start = time.time()\n",
        "  if sweep_path in raw_sweep_df_cache and not clear_colossus_cahce:\n",
        "    sweep_df = raw_sweep_df_cache[sweep_path]\n",
        "  else:\n",
        "    sweep_summary = os.path.join(sweep_path, 'summarycapacitor.csv')\n",
        "    sweep_df = convert_csv_to_dataframe(sweep_summary)\n",
        "    # sweep_df = colab_utils.convert_csv_to_dataframe(sweep_summary)\n",
        "    raw_sweep_df_cache[sweep_path] = sweep_df\n",
        "  print(f'Loaded {len(sweep_df)} configurations before cleaning.')\n",
        "  print(\"Time taken to load raw csv: {:.2f} s\".format(time.time() - start))\n",
        "  cleaned_df = clean_sweep_df(\n",
        "      df=sweep_df,\n",
        "      is_retrieval=is_retrieval,\n",
        "      return_pareto=return_pareto,\n",
        "      use_latency_after_throttling=use_latency_after_throttling,\n",
        "      qps_cutoff=qps_cutoff,\n",
        "      num_chips_keep_power_of_two=num_chips_keep_power_of_two)\n",
        "  print(f'Loaded {len(cleaned_df)} configurations after cleaning.')\n",
        "  print(\"Time taken (all): {:.2f} s\".format(time.time() - start))\n",
        "\n",
        "  if print_memory:\n",
        "    print_basic_sweep_info(cleaned_df)\n",
        "\n",
        "  return cleaned_df"
      ]
    },

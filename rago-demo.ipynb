      "source": [
        "# Example usage\n",
        "batch_size_dec = 16\n",
        "batch_size_initial = 16\n",
        "batch_size_iterative = 16\n",
        "latency_s_dec = 1\n",
        "latency_s_retrieval_initial = 0#0.2\n",
        "latency_s_retrieval_iterative = 0#0.1\n",
        "latency_s_prefix_initial = 0#0.1\n",

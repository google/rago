        "\n",
        "    x_lim=None\n",
        "    # if model_size == '8b':\n",
        "    #   x_lim = [0, 10 / max_num_chips]\n",
        "    # elif model_size == '70b':\n",
        "    #   x_lim = [0, 10 / max_num_chips]\n",
        "\n",
        "    for placement_policy in placement_policies:\n",
        "\n",
        "      df = result_df_dict_case_2_mapping[model_size][lc_size][placement_policy]\n",
        "      df = get_filtered_df(df, {'num_chips_e2e': num_chips})\n",
        "      legend_prefix = model_size.replace('b', 'B') + ' LLM'\n",
        "      if placement_policy == 'disaggregated':\n",
        "        df_pareto = get_pareto_df(\n",
        "                      sweep_df=df,\n",
        "                      keys_lower_is_better=[\n",
        "                        (x_key, get_lower_is_better(x_key)),\n",
        "                        (y_key, get_lower_is_better(y_key))],\n",
        "                      )\n",
        "        df_list.append(df_pareto)\n",
        "        legend = legend_prefix + ' + Disaggregated'\n",
        "        legend_list.append(legend)\n",
        "        linestyle_list.append('-')\n",
        "      elif placement_policy == 'collocated':\n",
        "        legend_prefix = legend_prefix + ' + Collocated'\n",
        "        strategies = set(df['collocation_strategy'])\n",
        "        for strategy in strategies:\n",
        "          df_strategy = get_filtered_df(df, {'collocation_strategy': strategy})\n",
        "          df_pareto = get_pareto_df(\n",
        "                        sweep_df=df_strategy,\n",
        "                        keys_lower_is_better=[\n",
        "                        (x_key, get_lower_is_better(x_key)),\n",
        "                        (y_key, get_lower_is_better(y_key))],\n",
        "                        )\n",
        "          df_list.append(df_pareto)\n",
        "          legend = legend_prefix + ' ' + strategy\n",
        "          legend_list.append(legend)\n",
        "          linestyle_list.append('--')\n",
        "\n",
        "    min_latency_s_ttft_list = []\n",
        "    max_qps_list = []\n",
        "    for df in df_list:\n",
        "      # Get the df and placement policy of best TTFT and QPS\n",
        "      min_latency_s_ttft_list.append(df['latency_s_ttft'].min())\n",
        "      max_qps_list.append(df['qps'].max())\n",
        "    min_latency_s_ttft = np.min(min_latency_s_ttft_list)\n",
        "    print(f\"Min latency s ttft: {min_latency_s_ttft}\")\n",
        "    for i, df in enumerate(df_list):\n",
        "      if min_latency_s_ttft_list[i] == min_latency_s_ttft:\n",
        "        print(\"\\t placement policy: \", set(df['placement_policy'].tolist()))\n",
        "      else:\n",
        "        print('\\t TTFT reduction compared to non-optimal policy = {:.2f}%'.format(\n",
        "            (min_latency_s_ttft_list[i] - min_latency_s_ttft) / min_latency_s_ttft_list[i] * 100))\n",
        "    max_qps = np.max(max_qps_list)\n",
        "    print(f\"Max qps: {max_qps}\")\n",
        "    for i, df in enumerate(df_list):\n",
        "      if max_qps_list[i] == max_qps:\n",
        "        print(\"\\t placement policy: \", set(df['placement_policy'].tolist()))\n",
        "      else:\n",
        "        print('\\t QPS speedup over non-optimal policy = {:.2f}x'.format(max_qps / max_qps_list[i]))\n",
        "\n",
        "    # Plot per model size x num_chips\n",
        "    plot_curve_df(\n",

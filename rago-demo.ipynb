    {
      "cell_type": "markdown",
      "metadata": {
        "id": "WO7wOmUtE7zj"
      },
      "source": [
        "**Run micro-batching sweep**\n",
        "\n",
        "Show the benefit of micro-batching. It will not benefit QPS: using the batch size of the request size can achieve the max QPS. It only benefits TTFT.\n",
        "\n",
        "The following script sweep across different request size and see the benefit."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "a9nAtwYcBpOc"
      },
      "outputs": [],
      "source": [
        "# Key = (size, num_query), e.g., ('8b', 8)\n",
        "result_df_dict_case_1_microbatching = {}\n",
        "\n",
        "model_sizes = ['8b', '70b']\n",
        "num_queries = [1, 2, 4, 8]\n",
        "# retrieval_options = ['with retrieval (1 query)',\n",
        "#                      'with retrieval (2 queries)',\n",
        "#                      'with retrieval (4 queries)',\n",
        "#                      'with retrieval (8 queries)',\n",
        "#                      ]\n",
        "retrieval_options = ['flexible batch sizes',\n",
        "                     'fixed batch sizes',\n",
        "                     ]\n",
        "\n",
        "for model_size in model_sizes:\n",
        "\n",
        "  result_df_dict_case_1_microbatching[model_size] = {}\n",
        "\n",
        "  for nq in num_queries:\n",
        "\n",
        "    result_df_dict_case_1_microbatching[model_size][nq] = {}\n",
        "\n",
        "    for retrieval_option in retrieval_options:\n",
        "\n",
        "      seq_len_inference_prefix = 512\n",
        "      use_retrieval = True\n",
        "      no_microbatching = False\n",
        "\n",
        "      if retrieval_option == 'fixed batch sizes':\n",
        "        no_microbatching = True\n",
        "      elif retrieval_option == 'flexible batch sizes':\n",
        "        no_microbatching = False\n",
        "      else:\n",
        "        raise ValueError(f'Unknown retrieval option: {retrieval_option}')\n",
        "\n",
        "      retrieval_df = get_filtered_df(\n",
        "              all_sweep_infos['large-db-inference-retrieval'],\n",
        "              {'parallel_mode_pq_scan_leaf': 'inter_query'})\n",
        "      # retrieval performance  shifted by batch size\n",
        "      def shift_batch_size(x):\n",
        "        return int(x / nq)\n",
        "      retrieval_df['batch_size'] = retrieval_df['batch_size'].apply(shift_batch_size)\n",
        "      retrieval_df = retrieval_df.loc[retrieval_df['batch_size'] >= 1]\n",
        "\n",
        "      rag_sweep = RAGSweep(\n",
        "          encode_db_policy=EncodeDBPolicy(run_encode_db=False),\n",
        "          retrieval_policy=RetrievalPolicy(run_retrieval=use_retrieval, retrieval_pattern='once'),\n",
        "          integration_policy=IntegrationPolicy(integration_pattern='prompt'),\n",
        "          stages=['retrieval', 'prefix', 'decode'],\n",
        "          sweep_df={\n",
        "              'rewrite_prefix': None,\n",
        "              'rewrite_decode': None,\n",
        "              'encode': all_sweep_infos[\"st-131m-inference-prefix\"],\n",
        "              'retrieval': retrieval_df,\n",
        "              'rerank': None,\n",
        "              'prefix': all_sweep_infos['rag-' + model_size + '-inference-prefix'],\n",
        "              'decode': all_sweep_infos['rag-' + model_size + '-inference-decode'],\n",
        "          },\n",
        "          db_nvec=int(64e9),\n",
        "          seq_len_inference_prefix=seq_len_inference_prefix,\n",
        "          dec_steps=256,\n",
        "          num_chips_per_server=4,\n",
        "        )\n",
        "      result_df_dict_case_1_microbatching[model_size][nq][retrieval_option] = rag_sweep.run_sweep_across_systems(\n",
        "          min_num_chips=64,\n",
        "          max_num_chips=64 * 2,\n",
        "          max_num_chips_per_stage=64,\n",
        "          placement_policy='disaggregated',\n",
        "          scheduling_policy='continuous-batching',\n",
        "          max_batch_size_request=128,\n",
        "          no_microbatching=no_microbatching,\n",
        "          verbose_microbatching_options=True,\n",
        "      )"
      ]
    },

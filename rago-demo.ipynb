      "source": [
        "## Case 3 Iterative Retrieval\n",
        "\n",
        "This type of RAG requires some sweep extension, so I put it last."
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "pKe8xOkQ_9hk"
      },
      "source": [
        "### Define Monte Carlo Simulation **Function**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Dct5BfLudyDt"
      },
      "outputs": [],
      "source": [
        "def simulate_iterative_retrieval_one_run(\n",
        "    batch_size_dec: int = 16,\n",
        "    batch_size_initial: int = 16,\n",
        "    batch_size_iterative: int = 1,\n",
        "    latency_s_dec_per_token: int = 10,\n",
        "    latency_s_retrieval_initial: int = 10,\n",
        "    latency_s_prefix_initial: int = 10,\n",
        "    latency_s_retrieval_iterative: int = 1,\n",
        "    latency_s_prefix_iterative: int = 1,\n",
        "    dec_steps: int = 256, # this\n",
        "    retrieval_interval : int = 64,\n",
        "    num_seq_to_simulate: int = 10, # the simulation can go beyond the len of one sequence\n",
        "):\n",
        "  \"\"\"\n",
        "  Simulate the performance of iterative retrievals in a three-stage system:\n",
        "    retrieval -> prefix -> decode\n",
        "\n",
        "  Each sequence has an \"initial\" retrieval-prefix phase, with several subsequent\n",
        "  \"iterative\" retrieval-prefix phases.\n",
        "\n",
        "  The assumpion of this simulation are:\n",
        "  1. Retrieval and prefix use the same batch size in the same phase.\n",
        "  2. The initial and iterative phases can use different batch sizes.\n",
        "  3. The iterative requests by the decoder is sent in a regular interval.\n",
        "  \"\"\"\n",
        "\n",
        "  num_iter_retrieval_per_seq = int(np.floor((dec_steps - 1) / retrieval_interval))\n",
        "  assert num_iter_retrieval_per_seq > 0\n",
        "  # e2e latency to evaluate in this setup\n",
        "  latency_s_dec = latency_s_dec_per_token * dec_steps\n",
        "\n",
        "  # number of requests need to be handled in the middle of generation\n",
        "  num_retrievals_iter = batch_size_dec * num_iter_retrieval_per_seq\n",
        "  num_initial_requests = batch_size_dec / batch_size_initial\n",
        "  num_iter_retrievals_between_initial = num_retrievals_iter / num_initial_requests\n",
        "\n",
        "  # Priority queue to track requests (iter_request_start_time, dec_seq_id)\n",
        "  dec_seq_request_queue = []\n",
        "\n",
        "  request_tick_list = []\n",
        "  for iter_id in range(num_seq_to_simulate):\n",
        "    request_tick_list.append(np.sort(np.random.uniform(\n",
        "      iter_id * latency_s_dec, (iter_id + 1) * latency_s_dec, (batch_size_dec, num_iter_retrieval_per_seq)), axis=1))\n",
        "  dec_seq_retrieval_time_array = np.concatenate(request_tick_list, axis=1)\n",
        "  assert dec_seq_retrieval_time_array.shape == (batch_size_dec, num_seq_to_simulate * num_iter_retrieval_per_seq)\n",
        "  # print(dec_seq_retrieval_time_array)\n",
        "\n",
        "  # Wenqi: linearly generate the request time is not reasonable => that means\n",
        "  # after processing a batch, the seqeunces are aligned for the next batch of\n",
        "  # queries, and thus no queueing delay.\n",
        "  # # Generate the time to send requests for each dec_seq within their task duration\n",
        "  # # now assuming these iterative requests are in regular interval\n",
        "  # dec_seq_retrieval_time_array = np.linspace(0, latency_s_dec, num_retrievals_iter)\n",
        "  # # reshape it to be in shape (batch_size_dec, num_iter_retrieval_per_seq)\n",
        "  # # and make sure that the requests from different sequences are interleaved\n",
        "  # # e.g., with batch size of 2 and 3 iterative retrievals per sequence\n",
        "  # # the original retrieval time can be [[1, 3, 5], [2, 4, 6]]\n",
        "  # dec_seq_retrieval_time_array = dec_seq_retrieval_time_array.reshape((num_iter_retrieval_per_seq, batch_size_dec)).T\n",
        "  # assert dec_seq_retrieval_time_array.shape == (batch_size_dec, num_iter_retrieval_per_seq)\n",
        "  # if num_iter_retrieval_per_seq > 1:\n",
        "  #   assert np.max(dec_seq_retrieval_time_array[:, 0]) < np.min(dec_seq_retrieval_time_array[:, 1])\n",
        "\n",
        "  for dec_seq_id in range(batch_size_dec):\n",
        "    # Add the first request for each dec_seq to the priority queue\n",
        "    iter_id = 0\n",
        "    heapq.heappush(dec_seq_request_queue, (dec_seq_retrieval_time_array[dec_seq_id][0], dec_seq_id, iter_id))  # (time, dec_seq_id, iter_id)\n",
        "\n",
        "  # Track the earliest available time of retrieval / prefix server\n",
        "  retrieval_server_time_tick = 0\n",
        "  prefix_server_time_tick = 0\n",
        "\n",
        "  # Track the finish time of each dec_seq\n",
        "  result_e2e_dec_latencys = np.zeros(batch_size_dec)\n",
        "  iter_request_latencys = np.zeros((batch_size_dec, num_iter_retrieval_per_seq * num_seq_to_simulate))\n",
        "  iter_request_start_times = np.zeros((batch_size_dec, num_iter_retrieval_per_seq * num_seq_to_simulate))\n",
        "  iter_request_finish_times = np.zeros((batch_size_dec, num_iter_retrieval_per_seq * num_seq_to_simulate))\n",
        "\n",
        "  # Now start the event-based simulation by processing the task queue\n",
        "  num_processed_iter_retrieval = 0\n",
        "  # Process requests in the priority queue\n",
        "  while dec_seq_request_queue:\n",
        "    # Track requests waiting to be batched\n",
        "    batch_iter_requests = []\n",
        "    batch_iter_request_start_time = []\n",
        "\n",
        "    # If we have fewer than batch_size requests, continue gathering them\n",
        "    # Only for the tail would have a chance for not having enough requests\n",
        "    while len(batch_iter_requests) < batch_size_iterative and dec_seq_request_queue:\n",
        "      iter_request_start_time, dec_seq_id, iter_id = heapq.heappop(dec_seq_request_queue)\n",
        "      batch_iter_requests.append((iter_request_start_time, dec_seq_id, iter_id))\n",
        "      batch_iter_request_start_time.append(iter_request_start_time)\n",
        "      iter_request_start_times[dec_seq_id][iter_id] = iter_request_start_time\n",
        "\n",
        "    # Check whether we need to process a request first\n",
        "    num_processed_iter_retrieval += len(batch_iter_requests)\n",
        "    while num_processed_iter_retrieval >= num_iter_retrievals_between_initial:\n",
        "      # Print statement if needed to track requests\n",
        "      # print(\"Running incoming request retrieval-prefix combination\")\n",
        "      retrieval_server_time_tick += latency_s_retrieval_initial\n",
        "      prefix_server_time_tick += latency_s_prefix_initial\n",
        "      num_processed_iter_retrieval -= num_iter_retrievals_between_initial\n",
        "\n",
        "    # Process the three-stage pipeline: retrieval -> prefix -> decode\n",
        "\n",
        "    # Retrieval stage\n",
        "    retrieval_start_time = np.max(batch_iter_request_start_time + [retrieval_server_time_tick])\n",
        "    retrieval_finish_time = retrieval_start_time + latency_s_retrieval_iterative\n",
        "    retrieval_server_time_tick = retrieval_finish_time\n",
        "\n",
        "    # Prefix stage (after retrieval is done)\n",
        "    prefix_start_time = np.max([retrieval_finish_time, prefix_server_time_tick])\n",
        "    prefix_finish_time = prefix_start_time + latency_s_prefix_iterative\n",
        "    prefix_server_time_tick = prefix_finish_time\n",
        "\n",
        "    # current decode time\n",
        "    current_time = prefix_finish_time\n",
        "\n",
        "    # Process the batch of requests\n",
        "    for iter_request_start_time, dec_seq_id, iter_id in batch_iter_requests:\n",
        "\n",
        "      # Check if the dec_seq has more requests to process\n",
        "      if iter_id + 1 < num_iter_retrieval_per_seq * num_seq_to_simulate:\n",
        "        # Add the dec_seq's next request to the priority queue\n",
        "        time_to_next_request = (\n",
        "            dec_seq_retrieval_time_array[dec_seq_id][iter_id + 1] -\n",
        "            dec_seq_retrieval_time_array[dec_seq_id][iter_id])\n",
        "        next_iter_request_start_time = current_time + time_to_next_request\n",
        "        heapq.heappush(dec_seq_request_queue, (next_iter_request_start_time, dec_seq_id, iter_id + 1))\n",
        "      else:\n",
        "        # If this was the last request, mark the dec_seq's finish time\n",
        "        time_to_finish = num_seq_to_simulate * latency_s_dec - dec_seq_retrieval_time_array[dec_seq_id][iter_id]\n",
        "        result_e2e_dec_latencys[dec_seq_id] = current_time + time_to_finish\n",
        "      request_latency = current_time - iter_request_start_time\n",
        "      iter_request_finish_times[dec_seq_id][iter_id] = current_time\n",
        "      iter_request_latencys[dec_seq_id][iter_id] = request_latency\n",
        "\n",
        "  # The total finish time is the time when the last dec_seq finishes their task\n",
        "  # total_finish_time = np.max(result_e2e_dec_latencys)\n",
        "  average_tbt = np.mean(result_e2e_dec_latencys) / (dec_steps * num_seq_to_simulate)\n",
        "  average_seq_latency = average_tbt * dec_steps\n",
        "  average_request_latency = np.mean(iter_request_latencys)\n",
        "  # print(\"Start time:\\n\", iter_request_start_times[:,:num_iter_retrieval_per_seq+1])\n",
        "  # print(\"Finish time:\\n\", iter_request_finish_times[:,:num_iter_retrieval_per_seq+1])\n",
        "  # print(\"Latency:\\n\", iter_request_latencys[:,:num_iter_retrieval_per_seq+1])\n",
        "  assert average_tbt >= latency_s_dec_per_token\n",
        "\n",
        "  return average_seq_latency, average_request_latency\n",
        "\n",
        "\n",
        "def simulate_iterative_retrieval(\n",
        "    batch_size_dec: int = 16,\n",
        "    batch_size_initial: int = 16,\n",
        "    batch_size_iterative: int = 1,\n",
        "    latency_s_dec_per_token: int = 10,\n",
        "    latency_s_retrieval_initial: int = 10,\n",
        "    latency_s_prefix_initial: int = 10,\n",
        "    latency_s_retrieval_iterative: int = 1,\n",
        "    latency_s_prefix_iterative: int = 1,\n",
        "    dec_steps: int = 256, # this\n",
        "    retrieval_interval : int = 64,\n",
        "    num_seq_to_simulate: int = 10, # the simulation can go beyond the len of one sequence\n",
        "    n_simulation_runs: int = 10,\n",
        "):\n",
        "  average_seq_latency_list = []\n",
        "  average_request_latency_list = []\n",
        "  for _ in range(n_simulation_runs):\n",
        "    average_seq_latency, average_request_latency = simulate_iterative_retrieval_one_run(\n",
        "        batch_size_dec=batch_size_dec,\n",
        "        batch_size_initial=batch_size_initial,\n",
        "        batch_size_iterative=batch_size_iterative,\n",
        "        latency_s_dec_per_token=latency_s_dec_per_token,\n",
        "        latency_s_retrieval_initial=latency_s_retrieval_initial,\n",
        "        latency_s_prefix_initial=latency_s_prefix_initial,\n",
        "        latency_s_retrieval_iterative=latency_s_retrieval_iterative,\n",
        "        latency_s_prefix_iterative=latency_s_prefix_iterative,\n",
        "        dec_steps=dec_steps,\n",
        "        retrieval_interval=retrieval_interval,\n",
        "        num_seq_to_simulate=num_seq_to_simulate,\n",
        "    )\n",
        "    average_seq_latency_list.append(average_seq_latency)\n",
        "    average_request_latency_list.append(average_request_latency)\n",
        "  average_seq_latency = np.mean(average_seq_latency_list)\n",
        "  average_request_latency = np.mean(average_request_latency_list)\n",
        "\n",
        "  return average_seq_latency, average_request_latency\n"
      ]
    },

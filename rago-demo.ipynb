        "        latency_dict_iterative_retrieval_db_char[throughput_dec_to_retrieval_ratio][batch_size_dec][batch_size_iterative][retrieval_interval] = {}\n",
        "        # print(f\"batch_size_iterative: {batch_size_iterative}, retrieval_interval: {retrieval_interval}\")\n",
        "        num_retrieval_per_seq = int(dec_steps / retrieval_interval)\n",

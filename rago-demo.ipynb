    {
      "cell_type": "markdown",
      "metadata": {
        "id": "hDOU6cyDGyNk"
      },
      "source": [
        "# End-to-end Performance Assembler\n",
        "\n",
        "Currently support disaggregated architecture with continuous batching. collocated mapping (prefix + decode) is not supported. Batched decoding (without continuous batching is not supported)."
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "j1JYyHO6b3Hh"
      },
      "source": [
        "## Base class"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ZQNFu5HIhAUR"
      },
      "outputs": [],
      "source": [
        "# Data classes of retrieval / inference policies\n",
        "\n",
        "@dataclasses.dataclass(frozen=True)\n",
        "class RetrievalPolicy:\n",
        "\n",
        "  # whether invoke retrieval at all\n",
        "  run_retrieval: bool = False\n",
        "\n",
        "  # retrieval pattern can be either \"once\" or \"interval\", for later, we need to\n",
        "  # specify the interval (retrieved once every N steps).\n",
        "  retrieval_pattern: str | None = None\n",
        "  retrieval_interval: int | None = None\n",
        "\n",
        "  # rewriter\n",
        "  run_rewrite: bool = False\n",
        "  # the question length, representing actual prefix inference workloads\n",
        "  rewrite_seq_len_inference_prefix: int | None = None\n",
        "  # the prefix is the rewrite instruction template + question, should be longer\n",
        "  # than the question itself\n",
        "  rewrite_seq_len_prefix_with_template: int | None = None #\n",
        "  rewrite_dec_steps: int | None = None\n",
        "\n",
        "  # reranker setup\n",
        "  run_rerank: bool = False\n",
        "  rerank_seq_len_inference_prefix: int | None = None\n",
        "  rerank_topk: int | None = None\n",
        "\n",
        "@dataclasses.dataclass(frozen=True)\n",
        "class EncodeDBPolicy:\n",
        "\n",
        "  # whether invoke encode db at all\n",
        "  run_encode_db: bool = False\n",
        "\n",
        "  # chunk length is the seq_len_inference_prefix for the encoder model\n",
        "  encode_seq_len_inference_prefix: int | None = None\n",
        "\n",
        "\n",
        "@dataclasses.dataclass(frozen=True)\n",
        "class IntegrationPolicy:\n",
        "\n",
        "  # integration pattern can be either \"prompt\" or \"encoder\" or \"interpolation\"\n",
        "  # or \"verify\"\n",
        "  integration_pattern: str | None = None\n",
        "\n",
        "class PhysicalMapping:\n",
        "\n",
        "  def __init__(self,\n",
        "               num_retrieval_servers: int = 0,\n",
        "               num_chips: dict[str, int] = {\n",
        "                  'rewrite_prefix': 0,\n",
        "                  'rewrite_decode': 0,\n",
        "                  'encode': 0,\n",
        "                  'rerank': 0,\n",
        "                  'prefix': 0,\n",
        "                  'decode': 0,\n",
        "                  'e2e': 0,\n",
        "              } ,\n",
        "               placement_policy: str = 'disaggregated', # 'collocated' or 'disaggregated'\n",
        "               collocation_strategy: list[list[str]] | None = None, #[['retrieval'], ['prefix'], ['decode']],\n",
        "               ):\n",
        "    self.num_retrieval_servers = num_retrieval_servers\n",
        "    self.num_chips = num_chips\n",
        "    self.placement_policy = placement_policy\n",
        "    self.collocation_strategy = collocation_strategy\n",
        "\n",
        "  # Print each of the attribute\n",
        "  def __str__(self):\n",
        "    return f'PhysicalMapping(num_retrieval_servers={self.num_retrieval_servers},' + \\\n",
        "      f'num_chips={self.num_chips}, placement_policy={self.placement_policy},' + \\\n",
        "      f'collocation_strategy={self.collocation_strategy})'"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "NnTPZwAHb6jL"
      },
      "outputs": [],
      "source": [
        "# The base class for sweep\n",
        "class RAGSweep:\n",
        "\n",
        "  def __init__(\n",
        "      self,\n",
        "      retrieval_policy: RetrievalPolicy,\n",
        "      encode_db_policy: EncodeDBPolicy,\n",
        "      integration_policy: IntegrationPolicy,\n",
        "      stages : list[str] = ['retrieval', 'prefix', 'decode'],\n",
        "      sweep_df : dict[str, pd.DataFrame | None] = {\n",
        "          'rewrite_prefix': None,\n",
        "          'rewrite_decode': None,\n",
        "          'encode': None,\n",
        "          'retrieval': None,\n",
        "          'rerank': None,\n",
        "          'prefix': None,\n",
        "          'decode': None,\n",
        "      },\n",
        "      db_nvec: int = int(1e3),\n",
        "      seq_len_inference_prefix: int = 4096,\n",
        "      dec_steps: int = 256,\n",
        "      num_chips_per_server: int = 4,\n",
        "    ):\n",
        "\n",
        "      # raw performance sweeps\n",
        "      self.stages = stages\n",
        "      self.sweep_df = sweep_df\n",
        "\n",
        "      # policies on retrieval, db encoding, and integration\n",
        "      self.retrieval_policy = retrieval_policy\n",
        "      self.integration_policy = integration_policy\n",
        "\n",
        "      # inference parameter constraints\n",
        "      self.db_nvec = db_nvec\n",
        "      self.seq_len_inference_prefix = seq_len_inference_prefix\n",
        "      self.dec_steps = dec_steps\n",
        "\n",
        "      # physical constant constraint\n",
        "      self.num_chips_per_server = num_chips_per_server\n",
        "\n",
        "      # Get filtered df per stage\n",
        "      self.sweep_df['prefix'] = get_filtered_df(\n",
        "          self.sweep_df['prefix'],\n",
        "          {'seq_len_inference_prefix': self.seq_len_inference_prefix})\n",
        "      assert len(self.sweep_df['prefix']) > 0\n",
        "      self.sweep_df['decode'] = get_filtered_df(\n",
        "          self.sweep_df['decode'],\n",
        "          {'seq_len_inference_prefix': self.seq_len_inference_prefix,\n",
        "          'dec_steps': self.dec_steps})\n",
        "      assert len(self.sweep_df['decode']) > 0\n",
        "\n",
        "      self.encode_db_policy = encode_db_policy\n",
        "      if encode_db_policy.run_encode_db:\n",
        "        assert 'encode' in self.stages\n",
        "        self.encode_seq_len_inference_prefix = encode_db_policy.encode_seq_len_inference_prefix\n",
        "        assert self.encode_seq_len_inference_prefix is not None\n",
        "        self.sweep_df['encode'] = get_filtered_df(\n",
        "            sweep_df['encode'],\n",
        "            {'seq_len_inference_prefix': self.encode_seq_len_inference_prefix})\n",
        "      else:\n",
        "        if 'encode' in self.stages:\n",
        "          self.stages.remove('encode')\n",
        "\n",
        "      if retrieval_policy.run_retrieval:\n",
        "        assert 'retrieval' in self.stages\n",
        "        self.sweep_df['retrieval'] = get_filtered_df(\n",
        "          self.sweep_df['retrieval'], {'db_nvec': self.db_nvec})\n",
        "        self.retrieval_interval = retrieval_policy.retrieval_interval\n",
        "        assert len(self.sweep_df['retrieval']) > 0\n",
        "      else:\n",
        "        if 'retrieval' in self.stages:\n",
        "          self.stages.remove('retrieval')\n",
        "\n",
        "      if retrieval_policy.run_rewrite:\n",
        "        assert 'rewrite_prefix' in self.stages\n",
        "        assert 'rewrite_decode' in self.stages\n",
        "        self.rewrite_seq_len_inference_prefix = retrieval_policy.rewrite_seq_len_inference_prefix\n",
        "        self.rewrite_seq_len_prefix_with_template = retrieval_policy.rewrite_seq_len_prefix_with_template\n",
        "        self.rewrite_dec_steps = retrieval_policy.rewrite_dec_steps\n",
        "        assert self.rewrite_seq_len_inference_prefix is not None\n",
        "        assert self.rewrite_seq_len_prefix_with_template is not None\n",
        "        assert self.rewrite_dec_steps is not None\n",
        "        self.sweep_df['rewrite_prefix'] = get_filtered_df(\n",
        "            self.sweep_df['rewrite_prefix'],\n",
        "            {'seq_len_inference_prefix': self.rewrite_seq_len_inference_prefix})\n",
        "        self.sweep_df['rewrite_decode'] = get_filtered_df(\n",
        "            self.sweep_df['rewrite_decode'],\n",
        "            {'seq_len_inference_prefix': self.rewrite_seq_len_prefix_with_template,\n",
        "             'dec_steps': self.rewrite_dec_steps})\n",
        "      else:\n",
        "        if 'rewrite_prefix' in self.stages:\n",
        "          self.stages.remove('rewrite_prefix')\n",
        "        if 'rewrite_decode' in self.stages:\n",
        "          self.stages.remove('rewrite_decode')\n",
        "\n",
        "      if retrieval_policy.run_rerank:\n",
        "        assert 'rerank' in self.stages\n",
        "        self.rerank_seq_len_inference_prefix = retrieval_policy.rerank_seq_len_inference_prefix\n",
        "        self.rerank_topk = retrieval_policy.rerank_topk\n",
        "        assert self.rerank_seq_len_inference_prefix is not None\n",
        "        assert self.rerank_topk is not None\n",
        "        self.sweep_df['rerank'] = get_filtered_df(\n",
        "            self.sweep_df['rerank'],\n",
        "            {'seq_len_inference_prefix': self.rerank_seq_len_inference_prefix})\n",
        "      else:\n",
        "        if 'rerank' in self.stages:\n",
        "          self.stages.remove('rerank')\n",
        "\n",
        "      assert 'prefix' in self.stages and 'decode' in self.stages\n",
        "      assert self.stages[-1] == 'decode'\n",
        "\n",
        "      for stage in self.stages:\n",
        "        assert self.sweep_df[stage] is not None and len(self.sweep_df[stage]) > 0\n",
        "\n",
        "      print(\"Effective stages: \", self.stages)\n",
        "\n",
        "      # Performance cache\n",
        "      # Key: [stage_name][num_chips or number of servers],\n",
        "      # Value: latency; possible batch size; perforamnce pareto\n",
        "      self.performance_pareto_dict = {}\n",
        "      self.possible_batch_sizes_dict = {}\n",
        "      self.latency_lookup_table_dict = {}\n",
        "      for stage in self.stages:\n",
        "        self.performance_pareto_dict[stage] = {}\n",
        "        self.possible_batch_sizes_dict[stage] = {}\n",
        "        self.latency_lookup_table_dict[stage] = {}\n",
        "\n",
        "      self.all_placement_strategies = None"
      ]
    },

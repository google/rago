        "\n",
        "\n",
        "def get_retrieval_util(\n",
        "    df_prefix,\n",
        "    df_decode,\n",
        "    df_retrieval,\n",
        "    seq_len_inference_prefix: int = 512,\n",
        "    dec_step_adjusted : int = 128,\n",
        "    # num_chips_per_server: int = 4,\n",
        "    ) -> list[float]:\n",
        "  \"\"\" Given a set of df, return the util% for retrieval \"\"\"\n",
        "\n",
        "  dec_steps_in_df = 256\n",
        "  # # Using larger prefix sizes to make sure decode cost is properly counted\n",
        "  # if dec_step_adjusted > dec_steps_in_df:\n",
        "  #   seq_len_inference_prefix *= 2\n",
        "\n",
        "  df_prefix = get_filtered_df(df_prefix, {'seq_len_inference_prefix': seq_len_inference_prefix})\n",
        "  df_decode = get_filtered_df(df_decode, {'seq_len_inference_prefix': seq_len_inference_prefix, 'dec_steps': dec_steps_in_df})\n",
        "\n",
        "  decode_qps_ratio = dec_steps_in_df / dec_step_adjusted\n",
        "\n",
        "  qps_per_chip_prefix = df_prefix['qps_per_chip'].max()\n",
        "  qps_per_chip_decode = df_decode['qps_per_chip'].max() * decode_qps_ratio\n",
        "  qps_per_chip_retrieval = df_retrieval['qps_per_chip'].max()\n",
        "\n",
        "  overall_workloads = 1 / qps_per_chip_prefix + 1 / qps_per_chip_decode + 1 / qps_per_chip_retrieval\n",
        "  rerieval_workloads = (1 / qps_per_chip_retrieval)\n",
        "  perc_workloads_retrieval = rerieval_workloads / overall_workloads * 100\n",
        "\n",
        "  return perc_workloads_retrieval\n",
        "\n",
        "model_sizes = ['8b', '70b']\n",
        "seq_len_inference_prefix_list = [128, 256, 512, 1024, 2048]\n",
        "dec_steps_list = [128, 256, 512]\n",
        "\n",
        "num_queries = [1, 2, 4, 8]\n",
        "batch_size_request_list = [2, 4, 8, 16, 32,]# 64]#, 128]\n",
        "plot_dirs = []\n",
        "\n",
        "for model_size in model_sizes:\n",
        "  print(f\"Model size: {model_size}\")\n",
        "  data = np.zeros((len(dec_steps_list), len(seq_len_inference_prefix_list)))\n",
        "  for i, dec_steps in enumerate(dec_steps_list):\n",
        "    for j, seq_len_inference_prefix in enumerate(seq_len_inference_prefix_list):\n",
        "      data[i, j] = get_retrieval_util(\n",
        "        df_prefix=all_sweep_infos['rag-' + model_size + '-inference-prefix'],\n",
        "        df_decode=all_sweep_infos['rag-' + model_size + '-inference-decode'],\n",
        "        df_retrieval=all_sweep_infos[\"large-db-inference-retrieval\"],\n",
        "        seq_len_inference_prefix=seq_len_inference_prefix,\n",
        "        dec_step_adjusted=dec_steps,\n",
        "        # num_chips_per_server: int = 4,\n",
        "        )\n",
        "\n",
        "  x_tick_labels = [str(nq) for nq in dec_steps_list]\n",
        "  y_tick_labels = [str(nq) for nq in seq_len_inference_prefix_list]\n",
        "\n",
        "  plot_name = f\"case_1_prefix_decode_length_{model_size.replace('b', 'B')}.pdf\"\n",
        "  print(\"plot name:\\n\", plot_name)\n",
        "  plot_dirs.append(plot_name)\n",
        "  plot_linear_heatmap(\n",
        "      data=data,\n",
        "      color_id=2,\n",
        "      x_tick_labels=seq_len_inference_prefix_list,\n",
        "      y_tick_labels=dec_steps_list,\n",
        "      x_label='Prefix length',\n",
        "      y_label='Decode length',\n",
        "      data_label=\"Time spent\\non retrieval (%)\",\n",
        "      plot_name='Case 1, ' + model_size.replace('b', 'B') + ' LLM',\n",
        "      label_font = 12,\n",
        "      title_font = 12,\n",
        "      tick_font = 10,\n",
        "      figsize=(3.5, 1.5),\n",
        "      fmt=\".1f\",\n",
        "      save_path=plot_dirs[-1],\n",
        "    )\n",
        "  fileedit.download_file(plot_dirs[-1], ephemeral=False)\n"

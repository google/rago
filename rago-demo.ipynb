        "lc_size = int(1e6) # lc size should be smaller to balance the workload between prefix and encode\n",
        "max_num_chips_list = [4, 8, 16, 32, 64]\n",
        "\n",
        "for model_size in model_sizes:\n",
        "\n",
        "  for max_num_chips in max_num_chips_list:\n",
        "\n",
        "    num_chips = [i for i in range(int(max_num_chips/2)+1, max_num_chips+1)]\n",
        "    print(f\"num chips range: {np.min(num_chips)} ~ {np.max(num_chips)}\")\n",
        "\n",
        "    df_list = []\n",
        "    legend_list = []\n",

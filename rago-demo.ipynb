      },
      "source": [
        "## Helper functions\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "EPa6WQ-5iHEv"
      },
      "outputs": [],
      "source": [
        "def get_filtered_df(df: pd.DataFrame, constraints: dict[str, Any] = {}):\n",
        "  \"\"\"Given a df with a dict of contraints, return the selected df rows\n",
        "\n",
        "  the values of the constraints can be either a single value of a list of values\n",
        "  \"\"\"\n",
        "  df_selected = copy.deepcopy(df)\n",
        "  if constraints is not None:\n",
        "    for key, value in constraints.items():\n",
        "      if value is None:\n",
        "        continue\n",
        "      if isinstance(value, list):\n",
        "        df_selected = df_selected.loc[(df_selected[key].isin(value))]\n",
        "      else:\n",
        "        df_selected = df_selected.loc[(df_selected[key] == value)]\n",
        "  return df_selected\n",
        "\n",
        "def is_pareto_efficient(costs: np.ndarray):\n",
        "    \"\"\"\n",
        "    Get pareto frontier mask, reference:\n",
        "      https://stackoverflow.com/questions/32791911/fast-calculation-of-pareto-front-in-python\n",
        "    :param costs: An (n_points, n_costs) np array -> always lower is better\n",
        "    :param return_mask: True to return a mask\n",
        "    :return: An array of indices of pareto-efficient points.\n",
        "        This will be an (n_points, ) boolean array\n",
        "    \"\"\"\n",
        "    is_efficient = np.arange(costs.shape[0])\n",
        "    n_points = costs.shape[0]\n",
        "    next_point_index = 0  # Next index in the is_efficient array to search for\n",
        "    while next_point_index<len(costs):\n",
        "        nondominated_point_mask = np.any(costs<costs[next_point_index], axis=1)\n",
        "        nondominated_point_mask[next_point_index] = True\n",
        "        is_efficient = is_efficient[nondominated_point_mask]  # Remove dominated points\n",
        "        costs = costs[nondominated_point_mask]\n",
        "        next_point_index = np.sum(nondominated_point_mask[:next_point_index])+1\n",
        "\n",
        "    is_efficient_mask = np.zeros(n_points, dtype = bool)\n",
        "    is_efficient_mask[is_efficient] = True\n",
        "    return is_efficient_mask\n",
        "\n",
        "def get_pareto_df(\n",
        "    sweep_df: pd.DataFrame,\n",
        "    keys_lower_is_better: list[str, bool],\n",
        "    qps_cutoff: float = 1.0, # remove points within 5% of optimal QPS\n",
        "):\n",
        "  \"\"\"Get the pareto optimal df, with specified cost columns.\n",
        "\n",
        "  Args:\n",
        "     sweep_df: the dataframe\n",
        "     keys_lower_is_better: a list of tuples of performance attributes and\n",
        "       whether lower is better, e.g.,\n",
        "       [('latency_s', True), ('qps_per_chip', False)]\n",
        "\n",
        "  \"\"\"\n",
        "  cost_arrays = []\n",
        "  for key, lower_is_better in keys_lower_is_better:\n",
        "    cost = sweep_df[key].to_numpy().reshape((-1, 1))\n",
        "    if not lower_is_better:\n",
        "      cost = 1 / cost\n",
        "    cost_arrays.append(cost)\n",
        "  cost_arrays = np.concatenate(cost_arrays, axis=1)\n",
        "  mask = is_pareto_efficient(cost_arrays)\n",
        "  performance_pareto = sweep_df.loc[mask]\n",
        "  key, lower_is_better = keys_lower_is_better[0]\n",
        "  performance_pareto = performance_pareto.sort_values(by=key, ascending=lower_is_better)\n",
        "\n",
        "  # Latest cutoff: remove all higher than the threshold, keep at least one point\n",
        "  # Old Cut off: keep the highest qps one, remove the ones close to highest\n",
        "  # assert qps_cutoff  == 1.0, \"Currently the cutoff function needs debugging\" + \\\n",
        "  #   + \"the cutoff may cut all low-latency points only caring qps\"\n",
        "  if qps_cutoff < 1:\n",
        "    max_qps = performance_pareto['qps'].max()\n",
        "    lowest_latency = performance_pareto['latency_s'].min()\n",
        "    threshold_qps = qps_cutoff * max_qps\n",
        "    performance_pareto = performance_pareto.loc[\n",
        "        (performance_pareto['qps'] <= threshold_qps) |\n",
        "        (performance_pareto['latency_s'] == lowest_latency)]\n",
        "        #  (performance_pareto['qps'] == max_qps)]\n",
        "\n",
        "  return performance_pareto\n",
        "\n",
        "def is_power_of_two(n: int) -> bool:\n",
        "  return (n & (n-1) == 0) and n != 0\n",
        "\n",
        "def get_power_of_two_list(\n",
        "    max_num: int,\n",
        "    start: int = 1) -> list[int]:\n",
        "  \"\"\"Get a list of power of two (e.g., batch sizes, chip numbers, etc.).\"\"\"\n",
        "  possible_num = [start]\n",
        "  while True:\n",
        "    new_num = possible_num[-1] * 2\n",
        "    if new_num <= max_num:\n",
        "      possible_num.append(new_num)\n",
        "    else:\n",
        "      break\n",
        "  return possible_num\n",
        "\n",
        "def context_len_to_str(context_len: int) -> str:\n",
        "  if context_len < 1000:\n",
        "    return str(context_len)\n",
        "  elif context_len < 1e6:\n",
        "    return str(int(context_len / 1e3)) + 'K'\n",
        "  elif context_len < 1e9:\n",
        "    return str(int(context_len / 1e6)) + 'M'\n",
        "  else:\n",
        "    return str(context_len)"
      ]
    },

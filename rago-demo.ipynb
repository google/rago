        "    retrieval_policy=RetrievalPolicy(\n",
        "        run_retrieval=True,\n",
        "        retrieval_pattern='once',\n",
        "        run_rewrite=run_rewrite,\n",
        "        rewrite_seq_len_inference_prefix=32,\n",
        "        rewrite_seq_len_prefix_with_template=128,\n",
        "        rewrite_dec_steps=32,\n",
        "        run_rerank=run_rerank,\n",
        "        rerank_seq_len_inference_prefix=128,\n",
        "        rerank_topk=16,\n",
        "        ),\n",
        "    integration_policy=IntegrationPolicy(integration_pattern='prompt'),\n",
        "    stages=['rewrite_prefix', 'rewrite_decode', 'retrieval', 'rerank', 'prefix', 'decode'],\n",
        "    sweep_df={\n",
        "        'rewrite_prefix': all_sweep_infos['query-rewriter-8b-inference-prefix'],\n",

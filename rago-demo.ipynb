    {
      "cell_type": "markdown",
      "metadata": {
        "id": "WznFjY4QZKgn"
      },
      "source": [
        "### Evaluation: Time (Workload) Breakdown\n",
        "\n",
        "Given the multi-query version of LLM + retrieval (without considering variants of DB implementation), break down the time consumption: where did the cycles go?\n",
        "\n",
        "**Please run the multi-query retrieval block before this one.**\n",
        "\n",
        "Get the setup with the highest QPS / lowest latency. Find time distribution for either cases -> so people get an idea what they should do to improve QPS / latency.\n",
        "\n",
        "Consumption per stage % = num_chips x util = num_chips x (qps_e2e / qps_stage) -> peak qps per stage is not achieved.\n",
        "\n",
        "Here, **one host server's cycle is assumed to be equivalent to 4 TPUs.**"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "yDezG404Xcua"
      },
      "source": [
        "#### Paper plot: breakdown"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "9wXdpWCcZk6O"
      },
      "outputs": [],
      "source": [
        "def get_row_util(df_row: pd.Series) -> list[float]:\n",
        "  \"\"\" Given a row of df, return the util% (retrieval, prefix, dec) \"\"\"\n",
        "  # assert df_row.shape[0] == 1\n",
        "  num_chips_prefix = df_row['num_chips_prefix']\n",
        "  num_chips_decode = df_row['num_chips_decode']\n",
        "  if df_row['placement_policy'] == 'disaggregated':\n",
        "    num_chips_retrieval = num_chips_prefix + num_chips_decode\n",
        "  else:\n",
        "    raise NotImplementedError\n",
        "  qps_retrieval = df_row['qps_retrieval']\n",
        "  qps_prefix = df_row['qps_prefix']\n",
        "  qps_decode = df_row['qps_decode']\n",
        "  qps = df_row['qps_per_chip']\n",
        "\n",
        "  if qps_retrieval == np.inf:\n",
        "    workload_retrieval = 0\n",
        "  else:\n",
        "    workload_retrieval = num_chips_retrieval * qps / qps_retrieval\n",
        "  workload_prefix = num_chips_prefix * qps / qps_prefix\n",
        "  workload_decode = num_chips_decode * qps / qps_decode\n",
        "  workload_total = workload_retrieval + workload_prefix + workload_decode\n",
        "\n",
        "  util_retrieval = workload_retrieval / workload_total\n",
        "  util_prefix = workload_prefix / workload_total\n",
        "  util_decode = workload_decode / workload_total\n",
        "\n",
        "  return [util_retrieval, util_prefix, util_decode]\n",
        "\n",
        "\n",
        "\n",
        "plot_dirs = []\n",
        "model_sizes = ['8b', '70b']\n",
        "retrieval_options = ['with retrieval (1 query)',\n",
        "                     'with retrieval (2 queries)',\n",
        "                     'with retrieval (4 queries)',\n",
        "                     'with retrieval (8 queries)',\n",
        "                    #  'no retrieval (with augmented prompt)',\n",
        "                    #  'no retrieval (only question)'\n",
        "                     ]\n",
        "\n",
        "for model_size in model_sizes:\n",
        "  util_array_best_latency = []\n",
        "  util_array_best_qps = []\n",
        "  x_tick_labels_best_latency = []\n",
        "  x_tick_labels_best_qps = []\n",
        "\n",
        "  for retrieval_option in retrieval_options:\n",
        "\n",
        "    seq_len_inference_prefix = 512\n",
        "    if retrieval_option == 'no retrieval (only question)':\n",
        "      seq_len_inference_prefix = 32\n",
        "\n",
        "    df_pareto = get_pareto_df(\n",
        "                  sweep_df=result_df_dict_case_1_multi_query[model_size][retrieval_option],\n",
        "                  keys_lower_is_better=[\n",
        "                    # ('latency_s', True),\n",
        "                    # ('latency_s_tbt', True),\n",
        "                    ('latency_s_ttft', True),\n",
        "                    ('qps_per_chip', False)],\n",
        "                  )\n",
        "\n",
        "    best_latency_row = df_pareto.loc[df_pareto['latency_s_ttft'].idxmin()]\n",
        "    best_qps_row = df_pareto.loc[df_pareto['qps_per_chip'].idxmax()]\n",
        "    if len(best_latency_row.shape) > 1:\n",
        "      best_latency_row = best_latency_row.iloc[0]\n",
        "    if len(best_qps_row.shape) > 1:\n",
        "      best_qps_row = best_qps_row.iloc[0]\n",
        "\n",
        "    # For the best QPS case, the cycles spent should not be the pure cycles spend,\n",
        "    # should be the theoretical QPS can be achieved in that stage --- they\n",
        "    # are not in the Pareto because they will not further optimize latency\n",
        "    num_chips_prefix = best_qps_row['num_chips_prefix']\n",
        "    num_chips_decode = best_qps_row['num_chips_decode']\n",
        "    df_prefix = get_filtered_df(\n",
        "        all_sweep_infos['rag-' + model_size + '-inference-prefix'],\n",
        "        {'seq_len_inference_prefix': seq_len_inference_prefix,\n",
        "         'num_chips': num_chips_prefix,\n",
        "         })\n",
        "    df_decode = get_filtered_df(\n",
        "        all_sweep_infos['rag-' + model_size + '-inference-decode'],\n",
        "        {'seq_len_inference_prefix': seq_len_inference_prefix,\n",
        "         'num_chips': num_chips_decode})\n",
        "    df_decode.loc[df_decode['num_chips'] == num_chips_decode]\n",
        "    print(\"before: \")\n",
        "    print(\"Prefix QPS: \", best_qps_row['qps_prefix'])\n",
        "    print(\"Decode QPS: \", best_qps_row['qps_decode'])\n",
        "    print(\"after finding the max qps: \")\n",
        "    prefix_qps_max = df_prefix['qps'].max()\n",
        "    decode_qps_max = df_decode['qps'].max()\n",
        "    print(\"Prefix QPS: \", prefix_qps_max)\n",
        "    print(\"Decode QPS: \", decode_qps_max)\n",
        "    best_qps_row['qps_prefix'] = prefix_qps_max\n",
        "    best_qps_row['qps_decode'] = decode_qps_max\n",
        "    # print(\"after: \", best_qps_row)\n",
        "\n",
        "    best_latency_util = get_row_util(best_latency_row)\n",
        "    best_qps_util = get_row_util(best_qps_row)\n",

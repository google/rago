        "id": "yshVuY93k0sT"
      },
      "source": [
        "### Optional: Database scan ratio sweep (only used in case 1)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ylqswW8NmzNO"
      },
      "outputs": [],
      "source": [
        "def load_sweep_info_database_ratio(\n",
        "    sweep_path: str,\n",
        "    return_pareto=True,\n",
        "    print_memory=True,\n",
        "    clear_colossus_cahce=False,\n",
        "    use_latency_after_throttling: bool = False,\n",
        "    qps_cutoff: float = 1.0, # remove points within 5% of optimal QPS\n",
        "    ):\n",
        "  \"\"\" Load sweep and return cleaned dataframe \"\"\"\n",
        "\n",
        "  start = time.time()\n",
        "  if sweep_path in raw_sweep_df_cache and not clear_colossus_cahce:\n",
        "    sweep_df = raw_sweep_df_cache[sweep_path]\n",
        "  else:\n",
        "    sweep_summary = os.path.join(sweep_path, 'summarycapacitor.csv')\n",
        "    sweep_df = convert_csv_to_dataframe(sweep_summary)\n",
        "    # sweep_df = colab_utils.convert_csv_to_dataframe(sweep_summary)\n",
        "    raw_sweep_df_cache[sweep_path] = sweep_df\n",
        "  print(f'Loaded {len(sweep_df)} configurations before cleaning.')\n",
        "  print(\"Time taken to load raw csv: {:.2f} s\".format(time.time() - start))\n",
        "\n",
        "  # Don't filter pareto here because we have a mix of scan ratio\n",
        "  cleaned_df = clean_sweep_df(\n",
        "      df=sweep_df,\n",
        "      is_retrieval=True,\n",
        "      return_pareto=False,\n",
        "      use_latency_after_throttling=use_latency_after_throttling,\n",
        "      qps_cutoff=qps_cutoff)\n",
        "  cleaned_df['scan_ratio'] =  cleaned_df['n_partitions_to_scan_leaf'] / cleaned_df['n_partitions_total_leaf']\n",
        "  scan_ratio_list = sorted(set(cleaned_df['scan_ratio'].tolist()))\n",
        "  database_scan_ratio_sweep_info = {}\n",
        "  for scan_ratio in scan_ratio_list:\n",
        "    database_scan_ratio_sweep_info[scan_ratio] = get_filtered_df(cleaned_df, {'scan_ratio': scan_ratio})\n",
        "  # print(f'Loaded {len(cleaned_df)} configurations after cleaning.')\n",
        "  # print(\"Time taken (all): {:.2f} s\".format(time.time() - start))\n",
        "\n",
        "  # if print_memory:\n",
        "  #   print_basic_sweep_info(cleaned_df)\n",
        "\n",
        "  return database_scan_ratio_sweep_info"
      ]
    },

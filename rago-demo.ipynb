      "outputs": [],
      "source": [
        "def print_gflops_prefix_decode(\n",
        "    df_prefix: pd.DataFrame,\n",
        "    df_decode: pd.DataFrame,\n",
        "    seq_len_inference_prefix : int = 512,\n",
        "    dec_steps: int = 256,\n",
        "    num_chips: int = 1,\n",
        "):\n",
        "\n",
        "  df = get_filtered_df(\n",
        "      df_prefix,\n",
        "      {'seq_len_inference_prefix': seq_len_inference_prefix,\n",
        "      'num_chips': num_chips,\n",
        "      'batch_size': 1,\n",
        "      }\n",
        "    )\n",
        "  gflops_prefix = set((df['compute_flops'] * df['num_chips']).tolist())\n",
        "  assert len(gflops_prefix) == 1\n",
        "  gflops_prefix = float(list(gflops_prefix)[0])\n",
        "  print(f\"Gflops prefix: {gflops_prefix:.2e}\")\n",
        "\n",
        "  df = get_filtered_df(\n",
        "      df_decode,\n",
        "      {'seq_len_inference_prefix': seq_len_inference_prefix,\n",
        "      'dec_steps': dec_steps,\n",
        "      'num_chips': num_chips,\n",
        "      'batch_size': 1,\n",
        "      }\n",
        "    )\n",
        "  gflops_decode = set((df['compute_flops'] * df['num_chips']).tolist())\n",
        "  assert len(gflops_decode) == 1\n",
        "  gflops_decode = float(list(gflops_decode)[0])\n",
        "  print(f\"Gflops decode: {gflops_decode:.2e} per step, {gflops_decode * dec_steps:.2e} overall\")\n",
        "\n",
        "  print(f\"Gflops overall: {gflops_prefix + gflops_decode * dec_steps:.2e}\")\n",
        "  print(f\"Gflops Prefix : Decode = {gflops_prefix / (gflops_decode * dec_steps):.2f}x\")"
      ]
    },

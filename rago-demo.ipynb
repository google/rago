    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "rZC9LhgA6Sww"
      },
      "source": [
        "### Evaluation: Time (Workload) Breakdown\n",
        "\n",
        "Break down the time consumption: where did the cycles go?\n",
        "\n",
        "Get the setup with the highest QPS / lowest latency. Find time distribution for either cases -> so people get an idea what they should do to improve QPS / latency.\n",
        "\n",
        "Consumption per stage % = num_chips x util = num_chips x (qps_e2e / qps_stage) -> peak qps per stage is not achieved.\n",
        "\n",
        "Here, one host server's cycle is assumed to be equivalent to 4 TPUs."
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Hdv3Hb6ZXvM6"
      },
      "source": [
        "#### Paper plot: breakdown"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Ixrr04QG6UwX"
      },
      "outputs": [],
      "source": [
        "def get_row_util(df_row: pd.Series) -> list[float]:\n",
        "  \"\"\" Given a row of df, return the util% (encode, retrieval, prefix, dec) \"\"\"\n",
        "  # assert df_row.shape[0] == 1\n",
        "  num_chips_encode = df_row['num_chips_encode']\n",
        "  num_chips_prefix = df_row['num_chips_prefix']\n",
        "  num_chips_decode = df_row['num_chips_decode']\n",
        "  num_chips_retrieval = df_row[\"num_retrieval_servers\"]\n",
        "\n",
        "  qps_encode = df_row['qps_encode']\n",
        "  qps_retrieval = df_row['qps_retrieval']\n",
        "  qps_prefix = df_row['qps_prefix']\n",
        "  qps_decode = df_row['qps_decode']\n",
        "  qps = df_row['qps_per_chip']\n",
        "\n",
        "  if qps_encode == np.inf:\n",
        "    workload_encode = 0\n",
        "  else:\n",
        "    workload_encode = num_chips_encode * qps / qps_encode\n",
        "  if qps_retrieval == np.inf:\n",
        "    workload_retrieval = 0\n",
        "  else:\n",
        "    workload_retrieval = num_chips_retrieval * qps / qps_retrieval\n",
        "  workload_prefix = num_chips_prefix * qps / qps_prefix\n",
        "  workload_decode = num_chips_decode * qps / qps_decode\n",
        "  workload_total = workload_encode + workload_retrieval + workload_prefix + workload_decode\n",
        "\n",
        "  util_encode = workload_encode / workload_total\n",
        "  util_retrieval = workload_retrieval / workload_total\n",
        "  util_prefix = workload_prefix / workload_total\n",
        "  util_decode = workload_decode / workload_total\n",
        "\n",
        "  return [util_encode, util_retrieval, util_prefix, util_decode]\n",
        "\n",
        "plot_dirs = []\n",
        "lc_sizes = [int(1e5), int(1e6), int(1e7)]\n",
        "\n",
        "for model_size in model_sizes:\n",
        "  util_array_best_latency = []\n",
        "  util_array_best_qps = []\n",
        "  x_tick_labels_best_latency = []\n",
        "  x_tick_labels_best_qps = []\n",
        "\n",
        "  for lc_size in lc_sizes:\n",
        "\n",
        "    if lc_size == 0:\n",
        "      continue\n",
        "\n",
        "    df_all_placement = pd.concat(\n",
        "        [result_df_dict_case_2_context_len[model_size][lc_size]['disaggregated'],\n",
        "        result_df_dict_case_2_context_len[model_size][lc_size]['collocated']])\n",
        "    df_pareto = get_pareto_df(\n",
        "                  sweep_df=df_all_placement,\n",
        "                  keys_lower_is_better=[\n",
        "                    # ('latency_s', True),\n",
        "                    # ('latency_s_tbt', True),\n",
        "                    ('latency_s_ttft', True),\n",
        "                    ('qps_per_chip', False)],\n",
        "                  )\n",
        "\n",
        "    best_latency_row = df_pareto.loc[df_pareto['latency_s_ttft'].idxmin()]\n",
        "    best_qps_row = df_pareto.loc[df_pareto['qps_per_chip'].idxmax()]\n",
        "    if len(best_latency_row.shape) > 1:\n",
        "      best_latency_row = best_latency_row.iloc[0]\n",
        "    if len(best_qps_row.shape) > 1:\n",
        "      best_qps_row = best_qps_row.iloc[0]\n",
        "\n",
        "    # For the best QPS case, the cycles spent should not be the pure cycles spend,\n",
        "    # should be the theoretical QPS can be achieved in that stage --- they\n",
        "    # are not in the Pareto because they will not further optimize latency\n",
        "\n",
        "    num_chips_prefix = best_qps_row['num_chips_prefix']\n",
        "    num_chips_decode = best_qps_row['num_chips_decode']\n",
        "    df_prefix = get_filtered_df(\n",
        "        all_sweep_infos['rag-' + model_size + '-inference-prefix'],\n",
        "        {'seq_len_inference_prefix': seq_len_inference_prefix,\n",
        "         'num_chips': num_chips_prefix,\n",
        "         })\n",
        "    df_decode = get_filtered_df(\n",
        "        all_sweep_infos['rag-' + model_size + '-inference-decode'],\n",
        "        {'seq_len_inference_prefix': seq_len_inference_prefix,\n",
        "         'num_chips': num_chips_decode})\n",
        "    df_decode.loc[df_decode['num_chips'] == num_chips_decode]\n",
        "    print(\"before: \")\n",
        "    print(\"Prefix QPS: \", best_qps_row['qps_prefix'])\n",
        "    print(\"Decode QPS: \", best_qps_row['qps_decode'])\n",
        "    print(\"after finding the max qps: \")\n",
        "    prefix_qps_max = df_prefix['qps'].max()\n",
        "    decode_qps_max = df_decode['qps'].max()\n",
        "    print(\"Prefix QPS: \", prefix_qps_max)\n",
        "    print(\"Decode QPS: \", decode_qps_max)\n",
        "    best_qps_row['qps_prefix'] = prefix_qps_max\n",
        "    best_qps_row['qps_decode'] = decode_qps_max\n",
        "    # print(\"after: \", best_qps_row)\n",
        "\n",
        "    best_latency_util = get_row_util(best_latency_row)\n",
        "    best_qps_util = get_row_util(best_qps_row)\n",
        "\n",
        "    if lc_size > 0:\n",
        "      legend = 'Context: ' + context_len_to_str(lc_size)\n",
        "      # legend = 'Doc len: ' + context_len_to_str(lc_size)\n",
        "    else:\n",
        "      legend = 'Short Doc'\n",
        "\n",
        "    print(f\"Model: {model_size}, LC: {lc_size}\")\n",
        "    print(\"util (encode, retrieval, prefix, decode):\")\n",
        "    print(best_latency_util)\n",
        "    print(best_qps_util)\n",
        "    # util_array_best_latency.append(best_latency_util)\n",
        "    # x_tick_labels_best_latency.append(legend + '\\n(best latency)')\n",
        "    util_array_best_qps.append(best_qps_util)\n",
        "    # x_tick_labels_best_qps.append(legend + '\\n(best qps)')\n",
        "    x_tick_labels_best_qps.append(legend)\n",
        "\n",
        "  util_array = util_array_best_latency + util_array_best_qps\n",
        "  x_tick_labels = x_tick_labels_best_latency + x_tick_labels_best_qps\n",
        "\n",
        "  legend_list = ['Encode', 'Retrieval', 'Prefix', 'Decode']\n",
        "  plot_name = model_size.replace('b', 'B') + ' LLM + long-context retrieval'\n",
        "  plot_dir = f\"case_2_breakdown_{model_size.replace('b', 'B')}.pdf\"\n",
        "  print(\"saved plot name: \", plot_dir)\n",
        "  plot_dirs.append(plot_dir)\n",
        "  plot_breakdown(\n",
        "        latency_array=util_array,\n",
        "        x_tick_labels=x_tick_labels,\n",
        "        legend_list=legend_list,\n",
        "        plot_name=plot_name,\n",
        "        show_perc=True,\n",
        "        mark_number=False,\n",
        "        y_label='Time (%)',\n",
        "        y_lim=[0,100],\n",
        "        label_font = 12,\n",
        "        title_font = 12,\n",
        "        legend_font = 10,\n",
        "        tick_font = 11,\n",
        "        legend_loc='lower right',\n",
        "        # legend_loc='best',\n",
        "        figsize=(3.5, 1.6),\n",
        "        save_path=plot_dirs[-1],\n",
        "    )\n",
        "  fileedit.download_file(plot_dirs[-1], ephemeral=False)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "q6vZ9rRz27c9"
      },
      "source": [
        "### Evaluation: Micro-batching"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "NNkMGE0pq9nD"
      },
      "outputs": [],
      "source": [
        "result_df_dict_case_2_batching = {}\n",
        "\n",
        "# model_sizes = ['70b']\n",
        "model_sizes = ['8b', '70b']\n",
        "placement_policies = ['disaggregated', 'collocated']\n",
        "lc_sizes = [int(1e5), int(1e6), int(1e7)] # token number\n",
        "chunk_size = 100\n",
        "\n",
        "\n",
        "for model_size in model_sizes:\n",
        "  result_df_dict_case_2_batching[model_size] = {}\n",
        "\n",
        "  for placement_policy in placement_policies:\n",
        "    result_df_dict_case_2_batching[model_size][placement_policy] = {}\n",
        "\n",
        "    for lc_size in lc_sizes:\n",
        "      result_df_dict_case_2_batching[model_size][placement_policy][lc_size] = {}\n",
        "\n",
        "      for no_microbatching in [True, False]:\n",
        "\n",
        "        db_nvec = int(lc_size / chunk_size)\n",
        "\n",
        "        rag_sweep = RAGSweep(\n",
        "            encode_db_policy=EncodeDBPolicy(run_encode_db=(True if lc_size else False), encode_seq_len_inference_prefix=128),\n",

        "# Optimal latency:\n",
        "num_batches_iter = batch_size_dec / batch_size_iterative * num_iter_retrieval_per_seq\n",
        "num_batches_init = batch_size_dec / batch_size_initial\n",
        "latency_optimal = np.max([latency_s_dec,\n",
        "                          latency_s_prefix_iterative * num_batches_iter + latency_s_prefix_initial * num_batches_init,\n",
        "                          latency_s_retrieval_iterative * num_batches_iter + latency_s_retrieval_initial * num_batches_init])\n",
        "print(f\"Optimal Latency: {latency_optimal}\")\n",
        "# expected_wait_interval = latency_s_dec / num_iter_retrieval_per_seq / (batch_size_dec / batch_size_iterative)\n",
        "# print(f\"Expected Wait Interval: {expected_wait_interval}\")\n",

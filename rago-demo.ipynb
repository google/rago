        "    df_all_placement = get_filtered_df(df_all_placement, {'num_chips_prefix': num_chips_prefix})\n",
        "\n",
        "    rag_best_ttft = df_all_placement['latency_s_ttft'].min()\n",
        "    rag_best_qps_per_chip = df_all_placement['qps_per_chip'].max()\n",
        "\n",
        "    # Long-context\n",
        "    lc_adjusted = int(1.024 * lc_size)\n",
        "    df_long_context_prefix = all_sweep_infos[f\"llama-{model_size}-longcontext-inference-prefix-sweep\"]\n",
        "    df_long_context_prefix = get_filtered_df(df_long_context_prefix,\n",
        "      {'num_chips': num_chips_prefix, 'seq_len_inference_prefix': lc_adjusted})\n",
        "    long_context_best_ttft = df_long_context_prefix['latency_s'].min()\n",
        "    long_context_best_qps_per_chip_prefix = df_long_context_prefix['qps_per_chip'].max()\n",
        "\n",
        "    df_long_context_decode = all_sweep_infos[f\"llama-{model_size}-longcontext-inference-decode-sweep\"]\n",
        "    long_context_best_qps_per_chip_decode = df_long_context_decode['qps_per_chip'].max()\n",
        "    long_context_best_qps_per_chip = 1 / (1 / long_context_best_qps_per_chip_prefix + 1 / long_context_best_qps_per_chip_decode)\n",
        "\n",
        "    print(f\"Best TTFT (sec): RAG: {rag_best_ttft:.2e}, LC: {long_context_best_ttft:.2e},\"\n",
        "      f\"speedup: {long_context_best_ttft / rag_best_ttft:.2f}x\")\n",
        "    print(f\"Best QPS/chip: RAG: {rag_best_qps_per_chip:.2e}, LC: {long_context_best_qps_per_chip:.2e},\"\n",
        "      f\"speedup: {rag_best_qps_per_chip / long_context_best_qps_per_chip:.2f}x\")"

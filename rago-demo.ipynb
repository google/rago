    {
      "cell_type": "markdown",
      "metadata": {
        "id": "46Tz_AUtKSIh"
      },
      "source": [
        "### Evaluation: Time (Workload) Breakdown\n",
        "\n",
        "Where did the cycles go?\n",
        "\n",
        "**Please run the previous enable/disable rewrite/rerank block before this one.**\n",
        "\n",
        "Get the setup with the highest QPS / lowest latency. Find time distribution for either cases -> so people get an idea what they should do to improve QPS / latency.\n",
        "\n",
        "Consumption per stage % = num_chips x util = num_chips x (qps_e2e / qps_stage) -> peak qps per stage is not achieved.\n",
        "\n",
        "Here, **one host server's cycle is assumed to be equivalent to 4 TPUs.**"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "c34NjElLatSK"
      },
      "source": [
        "#### Paper plot: breakdown"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "dR9XmXTZqlab"
      },
      "outputs": [],
      "source": [
        "def get_row_util(df_row: pd.Series) -> list[float]:\n",
        "  \"\"\" Given a row of df, return the util% (retrieval, prefix, dec) \"\"\"\n",
        "  # assert df_row.shape[0] == 1\n",
        "  num_chips_rewrite_prefix = df_row['num_chips_rewrite_prefix']\n",
        "  num_chips_rewrite_decode = df_row['num_chips_rewrite_decode']\n",
        "  num_chips_prefix = df_row['num_chips_prefix']\n",
        "  num_chips_rerank = df_row['num_chips_rerank']\n",
        "  num_chips_decode = df_row['num_chips_decode']\n",
        "  num_retrieval_servers = df_row['num_retrieval_servers']\n",
        "  num_chips_retrieval = num_retrieval_servers * 4\n",
        "\n",
        "  qps_rewrite_prefix = df_row['qps_rewrite_prefix']\n",
        "  qps_rewrite_decode = df_row['qps_rewrite_decode']\n",
        "  qps_retrieval = df_row['qps_retrieval']\n",
        "  qps_rerank = df_row['qps_rerank']\n",
        "  qps_prefix = df_row['qps_prefix']\n",
        "  qps_decode = df_row['qps_decode']\n",
        "  qps = df_row['qps_per_chip']\n",
        "\n",
        "  if qps_rewrite_prefix == np.inf:\n",
        "    workload_rewrite_prefix = 0\n",
        "  else:\n",
        "    workload_rewrite_prefix = num_chips_rewrite_prefix * qps / qps_rewrite_prefix\n",
        "  if qps_rewrite_decode == np.inf:\n",
        "    workload_rewrite_decode = 0\n",
        "  else:\n",
        "    workload_rewrite_decode = num_chips_rewrite_decode * qps / qps_rewrite_decode\n",
        "  if qps_retrieval == np.inf:\n",
        "    workload_retrieval = 0\n",
        "  else:\n",
        "    workload_retrieval = num_chips_retrieval * qps / qps_retrieval\n",
        "  if qps_rerank == np.inf:\n",
        "    workload_rerank = 0\n",
        "  else:\n",
        "    workload_rerank = num_chips_rerank * qps / qps_rerank\n",
        "  workload_prefix = num_chips_prefix * qps / qps_prefix\n",
        "  workload_decode = num_chips_decode * qps / qps_decode\n",
        "  workload_total = (\n",
        "      workload_rewrite_prefix + workload_rewrite_decode + workload_retrieval +\n",
        "      workload_rerank + workload_prefix + workload_decode)\n",
        "\n",
        "  util_rewrite_prefix = workload_rewrite_prefix / workload_total\n",
        "  util_rewrite_decode = workload_rewrite_decode / workload_total\n",
        "  util_retrieval = workload_retrieval / workload_total\n",
        "  util_rerank = workload_rerank / workload_total\n",
        "  util_prefix = workload_prefix / workload_total\n",
        "  util_decode = workload_decode / workload_total\n",
        "\n",
        "  return [util_rewrite_prefix, util_rewrite_decode, util_retrieval,\n",
        "          util_rerank, util_prefix, util_decode]\n"
      ]
    },

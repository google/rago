    {
      "cell_type": "markdown",
      "metadata": {
        "id": "QPRQnEArF9XF"
      },
      "source": [
        "### Sweep for the evaluation\n",
        "\n",
        "The setup is based on the following assumption:\n",
        "1. The main model prefix/dec num chips already decided (given their workload is around 1:1 as shown in the breakdown of case 2).\n",
        "2. Since the rewriter is much smaller (10x), and the prefix/decode size is also much smaller (~10x) we use around only less than 10x resources for them (e.g., if we spend 64 chips for main model, spend < 8 chips for rewrite).\n",
        "\n",
        "The above setup allows the sweep to be done in a reasonable amount of time ? min per rewrite prefix/dec chip combination - ? min.\n",
        "\n",
        "**Note: This is an EXPENSIVE RUN, can last for ~1 hour**\n",
        "\n",
        "\n",
        "**Perf bug: the following QPS/chip for 8B model won't be accurate given max_batch_size_request=32, however this cannot be fixed due to mem overflow for larger batch sizes (including 64) -> So please ONLY USE 70B E2E results in the paper**\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "x-oNItz5GHaZ"
      },
      "outputs": [],
      "source": [
        "# Key = (size, rewrite_or_not, rerank_or_not), e.g., ('8b', True)\n",
        "result_df_dict_case_4_rewrite_rerank = {}\n",
        "\n",
        "model_sizes = ['8b', '70b']\n",
        "rewrite_or_not = [True, False]\n",
        "rerank_or_not = [True, False]\n",
        "placement_policies = ['disaggregated', 'collocated']\n",
        "db_nvec = int(64e9)\n",
        "\n",
        "# possible_num_chips_rewrite_prefix=[1, 2, 4, 8, 16, 32, 64]\n",
        "# possible_num_chips_rewrite_decode=[1, 2, 4, 8, 16, 32, 64]\n",
        "# possible_num_chips_rerank=[1, 2, 4, 8, 16, 32, 64]\n",
        "possible_num_chips_rewrite_prefix=[1, 2, 4]\n",
        "possible_num_chips_rewrite_decode=[1, 2, 4]\n",
        "possible_num_chips_rerank=[1]\n",
        "possible_num_chips_prefix=[32]\n",
        "possible_num_chips_decode=[32]\n",
        "\n",
        "for model_size in model_sizes:\n",
        "  result_df_dict_case_4_rewrite_rerank[model_size] = {}\n",
        "  for run_rewrite in rewrite_or_not:\n",
        "    result_df_dict_case_4_rewrite_rerank[model_size][run_rewrite] = {}\n",
        "    for run_rerank in rerank_or_not:\n",
        "      result_df_dict_case_4_rewrite_rerank[model_size][run_rewrite][run_rerank] = {}\n",
        "      for placement_policy in placement_policies:\n",
        "        result_df_dict_case_4[I_rewrite_rerank[model_size][run_rewrite][run_rerank][placement_policy] = {}\n",
        "\n",
        "        # e2e comparison only use the no-microbatching option\n",
        "        no_microbatching_list = [True, False] if run_rewrite and run_rerank else [True]\n",
        "        verbose_microbatching_options = True if run_rewrite and run_rerank else False\n",
        "\n",
        "        for no_microbatching in no_microbatching_list:\n",
        "\n",
        "          print(\"=\" * 8, f\"Model size: {model_size}\",\n",
        "                f\"run_rewrite: {run_rewrite}\",\n",
        "                f\"run_rerank: {run_rerank}\",\n",
        "                f\"placement_policy: {placement_policy}\",\n",
        "                f\"no_microbatching: {no_microbatching}\",\n",
        "                \"=\" * 8)\n",
        "\n",
        "          rag_sweep = RAGSweep(\n",
        "              encode_db_policy=EncodeDBPolicy(run_encode_db=False),\n",
        "              retrieval_policy=RetrievalPolicy(\n",
        "                  run_retrieval=True,\n",
        "                  retrieval_pattern='once',\n",
        "                  run_rewrite=run_rewrite,\n",
        "                  rewrite_seq_len_inference_prefix=32,\n",
        "                  rewrite_seq_len_prefix_with_template=128,\n",
        "                  rewrite_dec_steps=32,\n",
        "                  run_rerank=run_rerank,\n",
        "                  rerank_seq_len_inference_prefix=128,\n",
        "                  rerank_topk=16,\n",
        "                  ),\n",
        "              integration_policy=IntegrationPolicy(integration_pattern='prompt'),\n",
        "              stages=['rewrite_prefix', 'rewrite_decode', 'retrieval', 'rerank', 'prefix', 'decode'],\n",
        "              sweep_df={\n",
        "                  'rewrite_prefix': all_sweep_infos['query-rewriter-8b-inference-prefix'],\n",
        "                  'rewrite_decode': all_sweep_infos['query-rewriter-8b-inference-decode'],\n",
        "                  'encode': None,\n",
        "                  'retrieval': get_filtered_df(\n",
        "                    all_sweep_infos['large-db-inference-retrieval'],\n",
        "                    {'parallel_mode_pq_scan_leaf': 'inter_query', 'db_nvec': db_nvec}),\n",
        "                  'rerank': all_sweep_infos[\"st-131m-inference-prefix\"],\n",
        "                  'prefix': all_sweep_infos['rag-' + model_size + '-inference-prefix'],\n",
        "                  'decode': all_sweep_infos['rag-' + model_size + '-inference-decode'],\n",
        "              },\n",
        "              db_nvec=db_nvec,\n",
        "              seq_len_inference_prefix=512,\n",
        "              dec_steps=256,\n",
        "              num_chips_per_server=4,\n",
        "            )\n",
        "\n",
        "          if placement_policy == 'disaggregated':\n",
        "            possible_num_chips = {\n",
        "                  'rewrite_prefix': possible_num_chips_rewrite_prefix,\n",
        "                  'rewrite_decode': possible_num_chips_rewrite_decode,\n",
        "                  'encode': None,\n",
        "                  'rerank': possible_num_chips_rerank,\n",
        "                  'prefix': possible_num_chips_prefix,\n",
        "                  'decode': possible_num_chips_decode,\n",
        "              }\n",
        "          else:\n",
        "            # Collocation allow the same number of chips to be used as prefix / decode\n",
        "            possible_num_chips = {\n",
        "                  'rewrite_prefix': list(set(possible_num_chips_rewrite_prefix + possible_num_chips_prefix)),\n",
        "                  'rewrite_decode': list(set(possible_num_chips_rewrite_decode + possible_num_chips_prefix)),\n",
        "                  'encode': None,\n",
        "                  'rerank': list(set(possible_num_chips_rerank + possible_num_chips_prefix)),\n",
        "                  'prefix': possible_num_chips_prefix,\n",
        "                  'decode': possible_num_chips_decode,\n",
        "              }\n",
        "\n",
        "\n",
        "          df_pareto_rewrite_rerank = rag_sweep.run_sweep_across_systems(\n",
        "            min_num_chips=64,\n",
        "            max_num_chips=128,\n",
        "            max_num_chips_per_stage=64,\n",
        "            placement_policy=placement_policy,\n",
        "            scheduling_policy='continuous-batching',\n",
        "            max_batch_size_request=32,\n",
        "            possible_num_chips=possible_num_chips,\n",
        "            no_microbatching=no_microbatching,\n",
        "            verbose_microbatching_options=verbose_microbatching_options,\n",
        "          )\n",
        "          result_df_dict_case_4_rewrite_rerank[model_size][run_rewrite][run_rerank][placement_policy][no_microbatching] = df_pareto_rewrite_rerank\n",
        "\n"
      ]
    },
